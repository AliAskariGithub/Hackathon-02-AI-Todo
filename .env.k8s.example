# Kubernetes Environment Configuration Template
# Copy this file to create your actual secrets (DO NOT commit secrets to git)

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Authentication Secrets
BETTER_AUTH_SECRET=your-better-auth-secret-key-here-min-32-chars
JWT_SECRET=your-jwt-secret-key-here-min-32-chars

# External API Keys
GROQ_API_KEY=your-groq-api-key-here

# Application Configuration (Non-sensitive - can also use ConfigMap)
LOG_LEVEL=info
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ENABLE_RATE_LIMITING=false
RATE_LIMIT_PER_MINUTE=100

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://backend-service:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_VERBOSE_LOGGING=true

# Backend Configuration
HOST=0.0.0.0
PORT=8001
JWT_EXPIRATION_DELTA_MINUTES=30
GROQ_MODEL=llama-3.3-70b-versatile
