# Backend Environment Variables Example
# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment

# =============================================================================
# Database Configuration
# =============================================================================

# Database URL
# Local: SQLite or local PostgreSQL
# Production: Neon PostgreSQL
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=your_database_connection_string_here

# =============================================================================
# Authentication Configuration
# =============================================================================

# Better Auth Secret (must match frontend secret)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-change-this-in-production

# JWT Secret for custom authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-here-change-this-in-production

# JWT Token Expiration (in minutes)
JWT_EXPIRATION_DELTA_MINUTES=30

# =============================================================================
# AI/LLM Configuration
# =============================================================================

# Groq API Key for AI chat functionality
GROQ_API_KEY=your-groq-api-key-here

# Groq Model to use
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Application Settings
# =============================================================================

# Server Host
HOST=0.0.0.0

# Server Port
# Local: 8000 or 8001
# Production: Usually set by hosting platform
PORT=8001

# Debug Mode (set to false in production)
DEBUG=true

# Log Level (debug, info, warning, error, critical)
LOG_LEVEL=info

# =============================================================================
# CORS Configuration
# =============================================================================

# Allowed Origins (comma-separated)
# Local: http://localhost:3000,http://localhost:3001
# Production: https://ai-y-todo.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Rate Limiting (Optional)
# =============================================================================

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Rate limit per minute
RATE_LIMIT_PER_MINUTE=60
