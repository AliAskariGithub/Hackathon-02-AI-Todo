# Frontend Environment Variables Example

# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment

# =============================================================================
# API Configuration
# =============================================================================

# Backend API Base URL
# Local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Production
# NEXT_PUBLIC_API_BASE_URL=https://aliaskariface-backend-todo-app.hf.space

# =============================================================================
# Site Configuration
# =============================================================================

# Site URL (used for redirects, canonical URLs, etc.)
# Local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production
# NEXT_PUBLIC_SITE_URL=https://ai-y-todo.vercel.app

# =============================================================================
# Authentication Configuration
# =============================================================================

# Better Auth Secret (generate a secure random string)
# Use: openssl rand -base64 32
BETTER_AUTH_SECRET="egz3jkCGjvTJ27lpHpCW99i7vg7LtfSW"

# LOCAL (should match NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# PRODUCTION (should match NEXT_PUBLIC_SITE_URL)
# NEXT_PUBLIC_BETTER_AUTH_URL=https://ai-y-todo.vercel.app

# =============================================================================
# Development Settings
# =============================================================================

# Local
NEXT_PUBLIC_DEBUG=true

# Production
# NEXT_PUBLIC_VERBOSE_LOGGING=false

# Local
NEXT_PUBLIC_VERBOSE_LOGGING=true

# Production
# NEXT_PUBLIC_VERBOSE_LOGGING=false